<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ═══════════════════ MAIN CONTENT ═══════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorChatBackground">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/colorInputBackground"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:id="@+id/toolbarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chats_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/toolbarSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/model_not_loaded"
                        android:textColor="?attr/colorSecondaryText"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- System Prompt -->
                <ImageButton
                    android:id="@+id/systemPromptButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:background="@android:color/transparent"
                    android:contentDescription="System Prompt"
                    app:tint="?android:attr/textColorPrimary"/>

                <!-- New chat -->
                <ImageButton
                    android:id="@+id/newChatButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_input_add"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/new_chat"
                    app:tint="@color/telegram_blue"/>
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Messages RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messagesRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingVertical="8dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintBottom_toTopOf="@id/inputPanel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ── Attachment previews row ── -->
        <LinearLayout
            android:id="@+id/attachmentRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:visibility="gone"
            android:background="?attr/colorInputBackground"
            app:layout_constraintBottom_toTopOf="@id/inputPanel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Image preview chip -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/imagePreviewCard"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>

                    <ImageButton
                        android:id="@+id/removeImageButton"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="2dp"
                        android:background="#80000000"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="@android:color/white"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Audio chip -->
            <LinearLayout
                android:id="@+id/audioPreviewCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_audio_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/audio_recorded"
                    android:textColor="@color/white"
                    android:textSize="13sp"/>

                <ImageButton
                    android:id="@+id/removeAudioButton"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@android:color/white"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Input panel ── -->
        <LinearLayout
            android:id="@+id/inputPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorInputBackground"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Attach image -->
            <ImageButton
                android:id="@+id/attachButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:background="@android:color/transparent"
                android:contentDescription="@string/pick_image"
                app:tint="?attr/colorSecondaryText"/>

            <!-- Audio record -->
            <ImageButton
                android:id="@+id/audioButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:background="@android:color/transparent"
                android:contentDescription="@string/record_audio"
                app:tint="?attr/colorSecondaryText"/>

            <!-- Text input field -->
            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="@string/message_hint"
                android:textColorHint="?attr/colorSecondaryText"
                android:textColor="?android:attr/textColorPrimary"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="5"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textSize="15sp"
                android:layout_marginHorizontal="6dp"/>

            <!-- Send button -->
            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_send_button"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="Send"
                app:tint="@color/white"
                android:enabled="false"
                android:alpha="0.5"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════ NAVIGATION DRAWER ═══════════════════ -->
    <LinearLayout
        android:id="@+id/drawerContent"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="?attr/colorDrawerBackground"
        android:fitsSystemWindows="true">

        <!-- Drawer header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/telegram_blue"
            android:paddingHorizontal="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="16dp">

            <!-- App logo circle -->
            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:text="AI"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/drawerModelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/model_not_loaded"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- New Chat button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/newChatDrawerButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="@string/new_chat"
            android:textAllCaps="false"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorDivider"
            android:layout_marginBottom="4dp"/>

        <!-- Theme toggle switch prominent -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/themeSwitchLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dark theme"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/themeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- GPU preference switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/gpuSwitchLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Use GPU"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/gpuSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorDivider"/>

        <!-- Chat list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatListRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- History limit button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/historyLimitButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:text="Context memory: 5"
            android:textAllCaps="false"/>

        <!-- Bottom: model select + theme toggle -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorDivider"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectModelDrawerButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/select_model"
                android:textAllCaps="false"/>

        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
